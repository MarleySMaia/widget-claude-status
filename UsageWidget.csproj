<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>UsageWidget</AssemblyName>
    <RootNamespace>UsageWidget</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <Version>1.0.0</Version>
    <Authors>MarleySMaia</Authors>
  </PropertyGroup>

  <!-- QR Code do Pix (opcional): coloque a imagem em Assets\pix-qr.png -->
  <ItemGroup Condition="Exists('Assets\pix-qr.png')">
    <Resource Include="Assets\pix-qr.png" />
  </ItemGroup>

</Project>
