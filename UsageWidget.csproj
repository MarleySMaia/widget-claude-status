<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>UsageWidget</AssemblyName>
    <RootNamespace>UsageWidget</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <Version>1.0.0</Version>
    <Authors>MarleySMaia</Authors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Gera o QR Code do Pix a partir do "Pix copia e cola" (MIT) -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <!-- Volume e mudo da saída/microfone padrão (Core Audio, MIT) -->
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

</Project>
